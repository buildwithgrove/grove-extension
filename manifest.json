{
  "manifest_version": 3,
  "name": "Grove - Tip Anyone, Anywhere",
  "version": "1.3.8",
  "description": "Tip anyone, anywhere - An extension that lets you tip anyone online.",
  "key": "",
  "permissions": ["storage", "identity"],
  "host_permissions": [
    "https://api.twitter.com/*",
    "https://twitter.com/*",
    "https://x.com/*",
    "https://api.cdp.coinbase.com/*",
    "https://api.developer.coinbase.com/*",
    "https://login.coinbase.com/*",
    "https://api.grove.city/*",
    "https://api.testnet.grove.city/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/logomark.png", "icons/logo.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost:*/*",
      "https://app.grove.city/*",
      "https://app.testnet.grove.city/*"
    ]
  },
  "content_scripts": [
    {
      "matches": ["https://twitter.com/*", "https://x.com/*"],
      "js": [
        "src/config/environments.js",
        "src/config/storageKeys.js",
        "src/config/chains.js",
        "src/utils/darkMode.js",
        "src/utils/addressCache.js",
        "src/parsers/addressMatchers.js",
        "src/parsers/address.js",
        "src/adapters/base.js",
        "src/adapters/twitter.js",
        "src/ui/constants.js",
        "src/ui/tipModal.js",
        "src/ui/errorBubble.js",
        "src/ui/button.js",
        "src/utils/api.js",
        "src/utils/tipErrors.js",
        "src/utils/bioFetcher.js",
        "src/content/hoverCardHandler.js",
        "src/content/profilePageHandler.js",
        "src/content/tweetTipHandler.js",
        "src/content/tweetProcessor.js",
        "src/auth/xAuth.js",
        "src/content/xFeatures.js",
        "src/content/content.js"
      ],
      "css": ["src/ui/styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://soundcloud.com/*"],
      "js": [
        "src/config/environments.js",
        "src/config/storageKeys.js",
        "src/config/chains.js",
        "src/utils/darkMode.js",
        "src/utils/addressCache.js",
        "src/parsers/addressMatchers.js",
        "src/parsers/address.js",
        "src/adapters/base.js",
        "src/adapters/soundcloud.js",
        "src/ui/constants.js",
        "src/ui/tipModal.js",
        "src/ui/errorBubble.js",
        "src/ui/button.js",
        "src/utils/api.js",
        "src/utils/tipErrors.js",
        "src/content/profilePageHandler.js",
        "src/content/content.js"
      ],
      "css": ["src/ui/styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.substack.com/*", "https://substack.com/*"],
      "js": [
        "src/config/environments.js",
        "src/config/storageKeys.js",
        "src/config/chains.js",
        "src/utils/darkMode.js",
        "src/utils/addressCache.js",
        "src/parsers/addressMatchers.js",
        "src/parsers/address.js",
        "src/adapters/base.js",
        "src/adapters/substack.js",
        "src/ui/constants.js",
        "src/ui/tipModal.js",
        "src/ui/errorBubble.js",
        "src/ui/button.js",
        "src/utils/api.js",
        "src/utils/tipErrors.js",
        "src/content/profilePageHandler.js",
        "src/content/substackHandler.js",
        "src/content/content.js"
      ],
      "css": ["src/ui/styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
      "js": [
        "src/config/environments.js",
        "src/config/storageKeys.js",
        "src/config/chains.js",
        "src/utils/darkMode.js",
        "src/utils/addressCache.js",
        "src/parsers/addressMatchers.js",
        "src/parsers/address.js",
        "src/adapters/base.js",
        "src/adapters/youtube.js",
        "src/ui/constants.js",
        "src/ui/tipModal.js",
        "src/ui/errorBubble.js",
        "src/ui/button.js",
        "src/utils/api.js",
        "src/utils/tipErrors.js",
        "src/content/profilePageHandler.js",
        "src/content/content.js"
      ],
      "css": ["src/ui/styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*/*", "http://*/*"],
      "exclude_matches": [
        "https://twitter.com/*",
        "https://www.twitter.com/*",
        "https://x.com/*",
        "https://www.x.com/*",
        "https://soundcloud.com/*",
        "https://www.soundcloud.com/*",
        "https://*.substack.com/*",
        "https://substack.com/*",
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "src/config/environments.js",
        "src/config/storageKeys.js",
        "src/config/chains.js",
        "src/utils/darkMode.js",
        "src/utils/addressCache.js",
        "src/parsers/addressMatchers.js",
        "src/parsers/address.js",
        "src/adapters/base.js",
        "src/adapters/generic.js",
        "src/utils/metadata.js",
        "src/ui/constants.js",
        "src/ui/tipModal.js",
        "src/ui/errorBubble.js",
        "src/ui/button.js",
        "src/utils/api.js",
        "src/utils/tipErrors.js",
        "src/content/content.js"
      ],
      "css": ["src/ui/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/logomark.png",
    "48": "icons/logomark.png",
    "128": "icons/logomark.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/logomark.png",
      "48": "icons/logomark.png",
      "128": "icons/logomark.png"
    },
    "default_title": "Grove - Tip with Crypto"
  }
}
