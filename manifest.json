{
  "manifest_version": 3,
  "name": "Grove - Tip Anyone, Anywhere",
  "version": "1.0.4",
  "description": "Tip anyone, anywhere - An extension that lets you tip anyone online.",
  "key": "",
  "permissions": ["storage", "identity"],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost:*/*",
      "https://app.grove.city/*",
      "https://app.testnet.grove.city/*"
    ]
  },
  "content_scripts": [
    {
      "matches": ["https://twitter.com/*", "https://x.com/*"],
      "js": [
        "src/parsers/address.js",
        "src/adapters/base.js",
        "src/adapters/twitter.js",
        "src/ui/constants.js",
        "src/ui/popover.js",
        "src/ui/button.js",
        "src/utils/api.js",
        "src/utils/tipErrors.js",
        "src/auth/xAuth.js",
        "src/content/content.js"
      ],
      "css": ["src/ui/styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*/*", "http://*/*"],
      "exclude_matches": [
        "https://twitter.com/*",
        "https://www.twitter.com/*",
        "https://x.com/*",
        "https://www.x.com/*"
      ],
      "js": [
        "src/parsers/address.js",
        "src/adapters/base.js",
        "src/adapters/generic.js",
        "src/utils/metadata.js",
        "src/ui/constants.js",
        "src/ui/popover.js",
        "src/ui/button.js",
        "src/utils/api.js",
        "src/utils/tipErrors.js",
        "src/content/content.js"
      ],
      "css": ["src/ui/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/logomark.png",
    "48": "icons/logomark.png",
    "128": "icons/logomark.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/logomark.png",
      "48": "icons/logomark.png",
      "128": "icons/logomark.png"
    },
    "default_title": "Grove - Tip with Crypto"
  }
}
